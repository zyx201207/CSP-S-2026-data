#include<bits/stdc++.h>
using namespace std;
const int N = 5e5 + 50;
typedef long long ll;
int a[N], b[N], c[N];
int main() {
	//freopen("and.in", "r", stdin);
	//freopen("and.out", "w", stdout);
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	int n, m;
	cin >> n >> m;
	for (int i = 1; i <= n; i ++) {
		cin >> a[i];
	}
	int t = n;
	while(t--) {
		for (int i = 1; i <= n; i ++) {
			for (int j = 1; j < i; j ++) {
				if (a[j] == a[i]) {
					for (int k = j; k < i; k ++) {
						b[k] = 0;
					}
				}
			}
			b[i] = a[i];
		}
		for (int i = 1; i <= m; i ++) {
			for (int j = 1; j <= n; j ++) {
				if (b[j] == i) {
					c[i] ++;
				}
			}
		}
		memset(b, 0, sizeof(b));
	}
	for (int i = 1; i <= m; i ++) {
		cout << c[i] << " ";
	}
	return 0;
}
