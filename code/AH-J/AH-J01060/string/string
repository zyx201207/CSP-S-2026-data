#include<bits/stdc++.h>
using namespace std;
int main(){
    freopen("string.in","r",stdin);
    freopen("string.out","w",stdout);
    ios::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);
    string s,c;
    long long n,a,sum=0,ans=0;
    cin>>n;
    for(long long i=1;i<=n;i++)
    {
        cin>>a>>c;
        for(long long j=1;j<=a;j++}
        {
            s=s+c;
        }
        sum+=a;
    }
    for(long long i=0;i<=sum/2-1;i++)
    {
        if(s[i]!=s[sum-i-1])ans++;
    }
    cout<<ans;
return 0;
}
